    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "wrangler": "^4.141.0"
  }
